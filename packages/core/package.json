{
    "name": "@ts2shell/core",
    "version": "0.1.0",
    "description": "TypeScript to shell transpiler core",
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc --build",
        "clean": "rm -rf dist *.tsbuildinfo",
        "lint": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "typescript": "^5.4.0"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "vitest": "^4.1.8"
    }
}
